<header class="home-hero">
    <div class="home-hero-copy">
        <p class="context-label">AERIX · Nueva temporada</p>
        <h1>Rendimiento que se siente.</h1>
        <p>Calzado e indumentaria para entrenar, competir y moverte con comodidad todos los días.</p>
        <div class="hero-actions">
            <a class="button button-accent" href="/products">Entrar al catálogo</a>
            <a class="text-link-light" href="/register">Crear una cuenta →</a>
        </div>
    </div>
    <div class="home-hero-visual">
        <img src="/img/air-max-270-black-1.jpg" alt="Nike Air Max 270 negra" width="960" height="960">
        <p><span>RUN</span><span>MOVE</span><span>TRAIN</span><span>RECOVER</span></p>
    </div>
</header>

<section class="project-strip" aria-label="Capacidades del proyecto">
    <p>Running para cada kilómetro</p>
    <p>Lifestyle todos los días</p>
    <p>Basketball dentro y fuera de la cancha</p>
    <p>Indumentaria liviana</p>
</section>

<section class="home-catalog" aria-labelledby="home-products-title">
    <div class="section-heading">
        <div>
            <p class="section-index">Lo más buscado</p>
            <h2 id="home-products-title">Favoritos de la temporada</h2>
        </div>
        <a class="text-link" href="/products">Ver catálogo con filtros →</a>
    </div>

    {{#if products.length}}
    <div class="product-grid product-grid-compact">
        {{#each products}}
        <article class="product-card">
            <a class="product-media" href="/products/{{this._id}}" aria-label="Ver detalle de {{this.title}}">
                {{#if this.thumbnails}}
                <img src="{{productImage this.thumbnails}}" alt="{{this.title}}" width="960" height="960" loading="lazy">
                {{/if}}
                <span class="category-chip">{{this.category}}</span>
            </a>
            <div class="product-card-body">
                <div class="product-card-heading">
                    <h3><a href="/products/{{this._id}}">{{this.title}}</a></h3>
                    <p class="price">USD {{formatPrice this.price}}</p>
                </div>
                <a class="text-link" href="/products/{{this._id}}">Ver producto →</a>
            </div>
        </article>
        {{/each}}
    </div>
    {{else}}
    <div class="empty-state" role="status">
        <strong>El catálogo está en preparación</strong>
        <p>No hay productos cargados todavía.</p>
    </div>
    {{/if}}
</section>
