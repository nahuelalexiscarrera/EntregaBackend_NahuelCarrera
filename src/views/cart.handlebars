<header class="page-header">
    <div>
        <p class="context-label context-label-dark">Tu selección</p>
        <h1>Mi carrito</h1>
    </div>
    <a class="button button-secondary" href="/products">Seguir comprando</a>
</header>

{{#if notFoundMessage}}
<div class="empty-state" role="alert">
    <strong>No encontramos ese carrito</strong>
    <p>{{notFoundMessage}}</p>
    <a href="/products">Volver al catálogo</a>
</div>
{{/if}}

{{#if items.length}}
<div class="cart-layout">
    <div class="cart-table-wrap">
        <table class="cart-table">
            <thead>
                <tr>
                    <th scope="col">Producto</th>
                    <th scope="col">Precio</th>
                    <th scope="col">Cantidad</th>
                    <th scope="col">Subtotal</th>
                    <th scope="col"><span class="sr-only">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                {{#each items}}
                <tr>
                    <td data-label="Producto">
                        <div class="cart-product">
                            {{#if this.product.thumbnails}}
                            <img src="{{productImage this.product.thumbnails}}" alt="" width="72" height="72">
                            {{/if}}
                            <div>
                                <strong>{{this.product.title}}</strong>
                                <span>{{this.product.category}}</span>
                            </div>
                        </div>
                    </td>
                    <td data-label="Precio">USD {{formatPrice this.product.price}}</td>
                    <td data-label="Cantidad"><span class="quantity-badge">{{this.quantity}}</span></td>
                    <td data-label="Subtotal"><strong>USD {{formatPrice this.subtotal}}</strong></td>
                    <td data-label="Acciones"><button class="button button-danger button-compact remove-from-cart" type="button" data-pid="{{this.product._id}}" data-cart="{{@root.cartId}}">Quitar</button></td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

    <aside class="cart-summary" aria-labelledby="summary-title">
        <p class="section-index">Resumen</p>
        <h2 id="summary-title">Todo listo.</h2>
        <div class="summary-total">
            <span>Total</span>
            <strong>USD {{formatPrice total}}</strong>
        </div>
        <p>Reservaremos tus productos cuando confirmes la compra.</p>
        <button class="button button-accent button-wide" id="purchaseBtn" type="button" data-cart="{{cartId}}">Finalizar compra</button>
        <div id="ticketResult" role="status" aria-live="polite"></div>
    </aside>
</div>
{{else}}
    {{#unless notFoundMessage}}
    <div class="empty-state empty-state-large" role="status">
        <span class="empty-state-mark" aria-hidden="true">0</span>
        <strong>Tu carrito está vacío</strong>
        <p>Explorá el catálogo y elegí el próximo producto para tu rotación.</p>
        <a class="button button-primary" href="/products">Ver productos</a>
    </div>
    {{/unless}}
{{/if}}

<script src="/js/cart.js"></script>
