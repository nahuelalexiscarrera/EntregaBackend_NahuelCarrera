<a href="/products">Volver a productos</a>

<div class="product-detail">
    <h1>{{product.title}}</h1>
    <p class="category">{{product.category}} — Código {{product.code}}</p>
    <p class="description">{{product.description}}</p>
    <p class="price">${{product.price}}</p>
    <p class="stock">Stock disponible: {{product.stock}}</p>

    {{#if (eq user.role 'user')}}
    <button class="add-to-cart" data-pid="{{product._id}}" data-cart="{{user.cart}}">Agregar al carrito</button>
    {{else}}
        {{#unless user}}
        <p><a href="/login">Iniciá sesión</a> para agregar productos al carrito.</p>
        {{/unless}}
    {{/if}}
</div>

<script src="/js/products.js"></script>
